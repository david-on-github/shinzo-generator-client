# Copy to .env; docker compose reads it automatically.

# Ethereum node (required)
GETH_RPC_URL=https://...
GETH_WS_URL=wss://...
GETH_API_KEY=
GETH_API_KEY_TYPE=x-api-key            # x-api-key | x-goog-api-key — the header your provider expects

# Node identity (required). Keep it the same across restarts or the keys cannot be opened.
SHINZO_KEY_PASSPHRASE=change-me        # or SHINZO_KEY_PASSPHRASE_FILE=/run/secrets/passphrase

# Optional
#SHINZO_GENERATOR_VERSION=latest       # image tag; pin to vX.Y.Z for production
#INDEXER_START_HEIGHT=0                # 0 = chain tip
#SCHEMA_AUTH_MODE=none                 # none | token | mtls
#SCHEMA_API_KEYS=key1,key2             # accepted bearer tokens when SCHEMA_AUTH_MODE=token
#ALLOWED_ORIGINS=http://localhost:3000 # extra browser origins (comma-separated)
#LOG_LEVEL=info                        # debug | info | warn | error
